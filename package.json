{
  "name": "pokemmo-tracker",
  "version": "1.0.28",
  "description": "Tracker personal para PokeMMO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "clean": "powershell -Command \"if (Test-Path dist) { Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue }\"",
    "release": "npm run clean && git add . && git commit -m \"chore: update version\" && git push && npm run dist -- --publish always"
  },
  "author": "Entrenador",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/JavierMB91/Proyecto-Pokemon.git"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {
    "electron-updater": "^6.7.3"
  },
  "build": {
    "appId": "com.pokemmo.tracker",
    "publish": [
      {
        "provider": "github",
        "owner": "JavierMB91",
        "repo": "Proyecto-Pokemon",
        "private": false,
        "releaseType": "release",
        "vPrefixedTagName": true
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "img/favicon.png"
    },
    "files": [
      "**/*"
    ]
  }
}