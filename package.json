{
  "name": "pokemmo-tracker",
  "version": "0.0.55",
  "private": true,
  "description": "Tracker personal para PokeMMO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "dotenv -e .env -- electron-builder",
    "clean": "timeout /t 2 > nul && rimraf dist",
    "publish": "npm run dist -- --publish always",
    "release": "call npm run clean && git add . && (git commit -m \"chore: save changes\" || echo No changes) && npm version patch && git push --follow-tags && npm run dist -- --publish always"
  },
  "author": "Entrenador",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/JavierMB91/Proyecto-Pokemon.git"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "rimraf": "^6.1.2"
  },
  "dependencies": {
    "electron-updater": "^6.7.3"
  },
  "build": {
    "appId": "com.pokemmo.tracker",
    "publish": [
      {
        "provider": "github",
        "owner": "JavierMB91",
        "repo": "Proyecto-Pokemon",
        "private": false,
        "releaseType": "release",
        "vPrefixedTagName": true
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "img/icon.ico"
    },
    "files": [
      "**/*"
    ]
  }
}
